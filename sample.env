# Copy to .env and fill in. An integration is enabled only when its required values are set.

# --- Claude (required) ---
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_MAX_TURNS=40

# --- GitHub: token with Contents read/write and Pull requests read/write ---
# (read-only investigations only need Contents read)
GITHUB_TOKEN=
# Where GitHub repos are cloned
# WORKSPACE_DIR=~/.cache/incident-agent

# --- PagerDuty: REST API key (Integrations > API Access Keys), read-only is enough ---
PAGERDUTY_API_TOKEN=
# EU accounts: https://api.eu.pagerduty.com
# PAGERDUTY_BASE_URL=https://api.pagerduty.com

# --- Sentry: auth token with org:read, project:read, event:read ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Self-hosted or regional (e.g. https://de.sentry.io)
# SENTRY_BASE_URL=https://sentry.io

# --- Elasticsearch: API key, or username + password ---
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_INDEX=logs-*
# ELASTICSEARCH_TIMESTAMP_FIELD=@timestamp
# ELASTICSEARCH_MESSAGE_FIELD=message
